// Cleo Camp Studio Admin — data model
// See SPEC.md for reasoning. See CLAUDE.md for the invariants that must hold.
//
// Conventions:
//   Money     — Int, in cents. `unitCostCents = 315` is $3.15.
//   Quantity  — Decimal(12,3). Fabric is bought in fractional yards.
//   Dates     — all boundaries computed in America/Los_Angeles, never UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema. They live in
// prisma.config.ts: DIRECT_URL (unpooled) for migrations, DATABASE_URL
// (pooled) for the app at runtime via a driver adapter.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// People & places
// ─────────────────────────────────────────────────────────────

/// Everyone who can create a todo, log an event, or be assigned something.
/// Auth is a single shared password, so this is attribution, not identity.
model Person {
  id          String   @id @default(cuid())
  name        String
  email       String?  @unique
  /// Other addresses this person sends from, comma-separated. Brandon sends
  /// from bc@thecampbrand.com as often as brandon@cleocamp.com, and Cleo from
  /// studio@cleocamp.com — neither is the address anything is configured to
  /// recognise, so "don't forward this back to whoever sent it" silently
  /// never matched either of them. Identity by inbox, not by one email field.
  aliasEmails String?
  role        String? // "Founder", "Project Manager — Manufacturing", etc.

  /// Secret behind this person's "tell Mouse" doors — the Siri shortcut and
  /// the home-screen page. The app's own login is one shared password whose
  /// session carries no identity, so this is the only thing that says who is
  /// speaking when an update arrives from a phone. Mint and rotate it with
  /// scripts/say-token.ts; never print it anywhere it would be logged.
  sayToken    String?  @unique

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  eventsCreated InventoryEvent[] @relation("EventCreatedBy")
  itemsCreated  ActionItem[]     @relation("ItemCreatedBy")
  itemsAssigned ActionItem[]     @relation("ItemAssignedTo")
}

/// One location today: the studio. Everything is here.
/// Exists so a 3PL in 2027 is a migration rather than a rewrite.
model Location {
  id                String   @id @default(cuid())
  name              String   @unique
  address           String?
  /// Shopify adjusts stock per location, so the write-through needs this.
  shopifyLocationId String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  variants ProductVariant[]
  events   InventoryEvent[]
  stock    ComponentLocationStock[]
}

// ─────────────────────────────────────────────────────────────
// Vendors
// ─────────────────────────────────────────────────────────────

enum VendorRole {
  COMPONENT_SUPPLIER
  MANUFACTURER
  DYE_HOUSE
  OTHER
}

model Vendor {
  id               String     @id @default(cuid())
  name             String
  legalName        String? // "Empire Sewing Inc" vs how Cleo says it, "Antonio's"
  role             VendorRole @default(COMPONENT_SUPPLIER)
  contactName      String?
  contactInfo      String?
  /// A real, structured email — contactInfo is freeform and often a phone
  /// number instead, so send_purchase_order reads this, never contactInfo.
  /// Null means ask, never guess or parse a number out of contactInfo.
  email            String?
  /// Standing extra recipients for every PO sent to this vendor — a
  /// production manager, a second contact. Comma-separated; send_purchase_order
  /// always cc's these, on top of Cleo and Brandon. Not the same as a one-off
  /// cc on a single email — this is "always", every time, until changed.
  ccEmails         String?
  address          String?
  /// How you actually place an order — email, phone, walk in, Etsy, Amazon.
  /// Studio Mouse tells Cleo which one she's dealing with.
  orderMethod      String?
  paymentTerms     String? // "COD", "Net 30"
  /// What language this vendor's documents are written in — "en" or "es",
  /// or "both" for a bilingual document. The default for every order to
  /// them, which a single order can still override. Null means English.
  /// Lorena and Santos and Empire are LA cut-and-sew shops; the office
  /// reading the PO and the floor cutting from it are not always the same
  /// people, which is what "both" is for.
  documentLanguage String?
  /// Turnaround in days. On a manufacturer this is cut-and-sew time; on a dye
  /// house it is dyeing time, which is a separate stage that adds to it.
  leadTimeDays     Int?
  /// Inactive vendors are retained with their history intact, never deleted.
  /// When a vendor is replaced, their prices and lead times become UNKNOWN on
  /// the new vendor — never inherited. See CLAUDE.md §3.
  active           Boolean    @default(true)
  notes            String?
  createdAt        DateTime   @default(now())

  components     Component[]
  productionRuns ProductionRun[]
  purchaseOrders PurchaseOrder[]
  /// Component stock currently held here rather than at the studio — see
  /// ComponentLocationStock.
  heldStock      ComponentLocationStock[]
  eventsHere     InventoryEvent[]         @relation("EventAtVendor")

  @@index([active, role])
}

// ─────────────────────────────────────────────────────────────
// Products
// ─────────────────────────────────────────────────────────────

enum ProductStatus {
  DEVELOPMENT
  SAMPLING
  ACTIVE
  SUNSETTED
}

model Product {
  id                     String        @id @default(cuid())
  name                   String
  shopifyProductId       String?
  status                 ProductStatus @default(DEVELOPMENT)
  /// CMT turnaround from "components in hand" to "finished goods ready to
  /// sell". Separate from any single component's lead time. Null = unknown,
  /// which blocks forecasting and must raise an ActionItem — never assume.
  productionLeadTimeDays Int?
  retailPriceCents       Int?
  notes                  String?
  createdAt              DateTime      @default(now())

  variants       ProductVariant[]
  colorways      Colorway[]
  bomLines       BomLine[]        @relation("ProductBom")
  productionRuns ProductionRun[]
  forecasts      ForecastResult[]
  calendarEvents CalendarEvent[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
}

/// Colors carry two names. Customers see "Shell"; LA Dye Masters calls it
/// "Shrinking Violet". Studio Mouse must speak both — telling Cleo to reorder
/// "Shell" is useless when she's on the phone with Martin.
model Colorway {
  id           String  @id @default(cuid())
  productId    String
  customerName String // "Shell", "Hot Pink", "Sunshine"
  dyeHouseName String? // "Shrinking Violet", "Pastel Yellow"
  pantone      String? // "639C"
  /// Set when there is no dye-house name because it's matched in-house.
  inHouseMatch Boolean @default(false)
  active       Boolean @default(true)
  notes        String?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, customerName])
  @@index([active])
}

model ProductVariant {
  id                     String   @id @default(cuid())
  productId              String
  colorwayId             String?
  shopifyVariantId       String?
  /// The InventoryItem gid — what Shopify's inventory API actually adjusts
  /// against, distinct from the variant id. Write-through needs this.
  shopifyInventoryItemId String?
  size                   String?
  /// The manufacturer-facing style code, e.g. "CCSS26COT-SHL01" — what goes
  /// on a cut-and-sew purchase order line, not Shopify's own variant id.
  /// Null means never given one, not blank on purpose.
  sku                    String?
  /// The product photo, pulled from Shopify (the variant's own image, or the
  /// product's featured image as a fallback) — refreshed on every sync, same
  /// as onHandQty. Used on a cut-and-sew PO so the maker sees what they're
  /// cutting, the way the reference orders from Shopify already do.
  imageUrl               String?
  /// Overrides the product price where a variant is priced differently — the
  /// Bean Bag is $368 in Petite and $398 in Medium.
  retailPriceCents       Int?
  locationId             String?
  /// Finished-goods on hand. NULL means UNKNOWN, not zero — the difference
  /// matters. Once Phase 1 wires Shopify this becomes a write-through cache of
  /// Shopify's number and is never edited independently. See CLAUDE.md §3.
  onHandQty              Decimal? @db.Decimal(12, 3)
  createdAt              DateTime @default(now())

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorway  Colorway?           @relation(fields: [colorwayId], references: [id])
  location  Location?           @relation(fields: [locationId], references: [id])
  events    InventoryEvent[]
  runLines  ProductionRunLine[]
  snapshots SalesSnapshot[]
  poLines   PurchaseOrderLine[]

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Components
// ─────────────────────────────────────────────────────────────

enum ComponentCategory {
  MATERIAL // fabric, leather, denim
  TRIM // buttons, tags, zippers
  HARDWARE // studs, snaps, magnets, rivets
  PACKAGING // glassine bags, stickers, hang tags — consumed per SHIPMENT
  SUBASSEMBLY // made from other components, e.g. Bateau handles
}

model Component {
  id       String            @id @default(cuid())
  name     String
  category ComponentCategory @default(MATERIAL)
  vendorId String?

  /// What the vendor calls it. Cleo says "fine rib"; RichLine says "1137".
  /// Studio Mouse must quote the vendor's own reference when reordering.
  vendorSku         String?
  vendorDescription String?
  spec              String? // "58-60\" wide, 220 gsm"

  /// Consumption unit — how it's used. Fabric: "yard".
  unitOfMeasure        String
  /// Purchase unit — how it's bought. Fabric: "roll".
  /// "Order 200 yards" is not something a vendor can sell.
  purchaseUnit         String?
  unitsPerPurchaseUnit Decimal? @db.Decimal(12, 3) // ~65 yards per roll

  /// NULL means unknown. Never inherit a replaced vendor's figures.
  leadTimeDays  Int?
  unitCostCents Int?

  reorderThreshold Decimal? @db.Decimal(12, 3)
  /// True only for something a real, if small, stash of actually sits in
  /// Cleo's own space — a jar of spare buttons kept for repairs, packaging
  /// used at the moment of shipping. False for anything bought per
  /// production run, which for most trim and hardware now means it ships
  /// straight to whichever vendor is cutting the run, not the studio.
  /// Brandon, 10 Sept: "we will rarely have buttons in studio, we will have
  /// them at various factories" — a category (HARDWARE, TRIM) never implied
  /// this; it is a fact about a specific purchase, and true was the wrong
  /// default for most of it. When true, a stock event defaults to the
  /// studio automatically. When false, WHERE the stock currently sits is
  /// real information — see ComponentLocationStock — not just "not here."
  /// Always false for MATERIAL (fabric): CLAUDE.md §3 forbids modeling
  /// fabric held at a manufacturer as stock at all, at any location.
  stockedInStudio  Boolean  @default(true)
  /// The TOTAL across every place this is held — the sum of every
  /// ComponentLocationStock row for this component. Forecasting and reorder
  /// thresholds read this; the per-place breakdown is what tells someone
  /// WHERE a shortage or a surplus actually is.
  onHandQty        Decimal  @default(0) @db.Decimal(12, 3)
  /// Derived from open PurchaseOrderLines — do not set directly.
  incomingQty      Decimal  @default(0) @db.Decimal(12, 3)
  active           Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())

  vendor        Vendor?                  @relation(fields: [vendorId], references: [id])
  events        InventoryEvent[]
  locationStock ComponentLocationStock[]
  usedIn        BomLine[]                @relation("BomComponent")
  subAssembly   BomLine[]                @relation("ComponentBom")
  poLines       PurchaseOrderLine[]
  forecasts     ForecastResult[]

  @@index([active, category])
}

/// Where a component's stock actually is, broken down by place — the studio,
/// or a vendor currently holding it. Materialized the same way onHandQty
/// itself is: written in the same transaction as the InventoryEvent that
/// changed it, and recomputable from the ledger alone.
///
/// Exactly one of locationId / atVendorId is set. Two separate unique
/// constraints rather than one compound check — Postgres treats NULL as
/// never equal to NULL, so @@unique([componentId, locationId]) alone would
/// let the same vendor appear twice for one component as long as locationId
/// stayed null on both rows. Splitting them means each pointer is uniquely
/// constrained on its own terms.
model ComponentLocationStock {
  id          String   @id @default(cuid())
  componentId String
  locationId  String?
  atVendorId  String?
  qty         Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id])
  atVendor  Vendor?   @relation(fields: [atVendorId], references: [id])

  @@unique([componentId, locationId])
  @@unique([componentId, atVendorId])
}

/// A bill-of-materials line. The parent is either a Product or another
/// Component (Bateau handles are leather + rivets, assembled before the bag).
/// Exactly one of parentProductId / parentComponentId is set — enforced by a
/// check constraint added in the migration, since Prisma can't express it.
model BomLine {
  id                String  @id @default(cuid())
  parentProductId   String?
  parentComponentId String?
  componentId       String
  qtyPerUnit        Decimal @db.Decimal(12, 4)
  notes             String?

  parentProduct   Product?   @relation("ProductBom", fields: [parentProductId], references: [id], onDelete: Cascade)
  parentComponent Component? @relation("ComponentBom", fields: [parentComponentId], references: [id], onDelete: Cascade)
  component       Component  @relation("BomComponent", fields: [componentId], references: [id])

  @@unique([parentProductId, componentId])
  @@unique([parentComponentId, componentId])
}

// ─────────────────────────────────────────────────────────────
// Inventory movement — append-only ledger
// ─────────────────────────────────────────────────────────────

enum InventoryEventType {
  RECEIVED
  USED
  COUNTED
  MANUAL_ADJUST
  GIFTED // out permanently, counts as demand
  WHOLESALE_SHIPPED // out permanently, counts as demand
  STYLIST_PULL_OUT // out on loan, NOT demand
  STYLIST_PULL_RETURN
  RETURNED
  CORRECTION
  /// Stock moving between places — the studio and a vendor, or one vendor
  /// and another — with the count unchanged overall. Always written as a
  /// matched pair, one negative at the source and one positive at the
  /// destination, linked by transferGroupId.
  TRANSFER
}

enum InventoryEventSource {
  CHAT
  MANUAL
  SYSTEM
}

/// APPEND ONLY. Never edit, never delete. Mistakes are corrected by a new
/// CORRECTION event linked via correctsEventId, so the original statement
/// survives in the audit trail. See CLAUDE.md §3.
model InventoryEvent {
  id               String  @id @default(cuid())
  componentId      String?
  productVariantId String?

  /// WHERE a component event happened — the studio, or a vendor currently
  /// holding it. Exactly one of the two, and only meaningful for a component
  /// event; a productVariant event leaves both null, since Shopify is the
  /// one place finished goods live. Brandon, 10 Sept: "we will rarely have
  /// buttons in studio, we will have them at various factories... SM exists
  /// for clear accounting" — the ledger has to know WHERE, not only HOW MANY,
  /// or Mouse cannot tell a shortage at Antonio's from a surplus at Staples.
  /// Never set for a MATERIAL (fabric) component — CLAUDE.md §3 is explicit
  /// that fabric held at a manufacturer is never modeled as stock at all.
  locationId String?
  atVendorId String?

  /// Signed change. Always set.
  deltaQty   Decimal  @db.Decimal(12, 3)
  /// For COUNTED only: the absolute number Cleo actually said ("I counted 40").
  /// deltaQty carries the derived change. Storing only the delta would lose
  /// what she told us.
  countedQty Decimal? @db.Decimal(12, 3)

  type            InventoryEventType
  source          InventoryEventSource @default(CHAT)
  note            String?
  createdById     String?
  chatMessageId   String?
  correctsEventId String?
  /// Links the two halves of a TRANSFER — the negative at the source and the
  /// positive at the destination — so one can be found from the other.
  transferGroupId String?
  createdAt       DateTime             @default(now())

  location Location? @relation(fields: [locationId], references: [id])
  atVendor Vendor?   @relation("EventAtVendor", fields: [atVendorId], references: [id])

  component      Component?       @relation(fields: [componentId], references: [id])
  productVariant ProductVariant?  @relation(fields: [productVariantId], references: [id])
  createdBy      Person?          @relation("EventCreatedBy", fields: [createdById], references: [id])
  chatMessage    ChatMessage?     @relation(fields: [chatMessageId], references: [id])
  corrects       InventoryEvent?  @relation("Corrections", fields: [correctsEventId], references: [id])
  correctedBy    InventoryEvent[] @relation("Corrections")

  @@index([componentId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([type, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Production — visibility and lead times only, NO inventory
// ─────────────────────────────────────────────────────────────

enum ProductionStatus {
  PLANNED
  COMPONENTS_ORDERED
  IN_PRODUCTION
  AT_DYE_HOUSE
  FINISHING
  READY_FOR_PICKUP
  RECEIVED
  CANCELLED
}

/// Tracks where a run is so Cleo can ask "where is my run?" and so lead times
/// chain. Holds NO inventory — nothing counts until it reaches the studio.
model ProductionRun {
  id              String           @id @default(cuid())
  productId       String
  vendorId        String? // the CMT
  /// The manufacturer's own reference — Fashion Garcia used "Cut #12".
  cutRef          String?
  status          ProductionStatus @default(PLANNED)
  startedAt       DateTime?
  expectedReadyAt DateTime?
  /// Null when the manufacturer hasn't confirmed a date yet. Common.
  dateConfirmed   Boolean          @default(false)
  /// The journey in one line — "at Fashion Garcia, to dye house 10 Sep, ~2wk
  /// dyeing, then back for buttons". A single date cannot express a job that
  /// moves between three places, and the date alone reads as completion when
  /// it is often only the next hand-off.
  statusSummary   String?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime         @default(now())

  product Product             @relation(fields: [productId], references: [id])
  vendor  Vendor?             @relation(fields: [vendorId], references: [id])
  lines   ProductionRunLine[]
  costs   ProductionRunCost[]

  @@index([status])
}

model ProductionRunLine {
  id               String  @id @default(cuid())
  runId            String
  productVariantId String
  qtyOrdered       Decimal @db.Decimal(12, 3)
  qtyReceived      Decimal @default(0) @db.Decimal(12, 3)

  run     ProductionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id])
}

/// Runs carry flat costs as well as per-unit costs — cutting setup, transport
/// to and from the dye house, fabric pickup. Without these, small-run economics
/// are invisible: Fashion Garcia's flat $165 cutting charge is $1.47/unit on a
/// 112-unit run and $0.35/unit on 1,411. That gap is why Studio Mouse can say a
/// small run is expensive and show its working.
model ProductionRunCost {
  id          String  @id @default(cuid())
  runId       String
  description String // "Cutting", "Transport to dye house"
  isPerUnit   Boolean @default(false)
  amountCents Int

  run ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Purchasing
// ─────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Studio Mouse generates these from remembered vendor and component detail —
/// "build a PO for fabric for Cleo tees" should already know RichLine, Michael
/// Pollack, style 1137, $3.15/yd, and the ship-to address, and ask only for
/// what it genuinely doesn't have.
/// Open lines are what `Component.incomingQty` derives from.
model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @unique
  vendorId             String
  status               PurchaseOrderStatus @default(DRAFT)
  orderedAt            DateTime?
  expectedAt           DateTime?
  receivedAt           DateTime?
  shipToLocationId     String?
  /// Where it physically goes, for the PO document. Fabric ships to the
  /// manufacturer, not the studio, so this is rarely Cleo's address.
  deliverTo            String?
  /// What the order is for. A vendor seeing "for the Cleo Tee" can catch a
  /// wrong fabric before it ships, and it is how anyone later works out why
  /// the order existed.
  forProductId         String?
  /// Payment terms as agreed, in plain words for the PO document.
  paymentTerms         String?
  /// Who the vendor should confirm receipt with, one per line, for this
  /// order only. Null falls back to DocumentDefaults — which is the usual
  /// case. Here because a draft gets edited: "put Nicki on this one" is a
  /// content change, not a template change, and nobody should have to know
  /// the difference to make it.
  contactLines         String?
  /// "en", "es" or "both" — what language the document renders in, labels
  /// and dates. Defaults from the vendor's documentLanguage when not given.
  /// Only the fixed chrome is translated by the app; notes, terms and line
  /// text are content, written in the right language when they are written.
  /// See lib/po-strings.ts.
  language             String              @default("en")
  /// Percentage due at order rather than on delivery. RichLine take 50% up
  /// front on the lurex stripe.
  depositPercent       Int?
  /// Days after delivery the balance falls due. The rib is net 60.
  netDaysAfterDelivery Int?
  /// When the deposit actually went out. Lead times that run "from PO" often
  /// really run from payment, so this is what the arrival date is counted from.
  depositPaidAt        DateTime?
  /// PRINTS ON THE PDF THE VENDOR RECEIVES. This is not a scratchpad.
  /// Everything in here is read by the supplier, so it holds only what someone
  /// deliberately wrote TO them — a rush request, a spec, a payment
  /// confirmation. Never our own reasoning: never what a line used to cost,
  /// never a rate we disputed, never another person's name or opinion, never
  /// what still needs checking internally. On 16 Sept 2026 a repricing
  /// rationale was written here — the old rate, the saving, and which of our
  /// people had disputed a supplier's number — and it went straight onto
  /// Antonio's copy. Internal commentary belongs in Note with
  /// entityType PURCHASE_ORDER, which is never rendered. Brandon had already
  /// asked for the same thing on 4 Sept: "notes at the end of pdf should only
  /// be notes i sent, not an endless list of things SM puts there."
  notes                String?
  createdAt            DateTime            @default(now())

  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  forProduct Product?            @relation(fields: [forProductId], references: [id])
  lines      PurchaseOrderLine[]

  @@index([status])
}

/// Immutable clean copies. Exporting a document never changes order status.
/// The exact PDF is retained so later edits cannot change a copy already shared.

/// A line is either a component (fabric, trim — a purchase order to a
/// supplier) or a product variant (finished units — a cut-and-sew order to a
/// manufacturer like Empire Sewing). Exactly one of componentId /
/// productVariantId is set; nothing in the schema forces that, so every
/// writer must, the same convention InventoryEvent already uses.
model PurchaseOrderLine {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  componentId      String?
  productVariantId String?
  /// What is being ordered, when it is not yet a catalogue row. A purchase
  /// order is how a NEW thing comes into existence — a colour that does not
  /// exist yet, a product being sampled, a size nobody has cut before — so a
  /// line must be able to describe something the catalogue has never heard
  /// of. Ignored when componentId or productVariantId is set; those carry
  /// their own name. See lib/po.ts:poLineLabel.
  description      String?
  /// Quantity in the PURCHASE unit (rolls, or finished pieces for a
  /// cut-and-sew line), with the conversion recorded so incoming stock lands
  /// in the consumption unit (yards).
  qtyOrdered       Decimal @db.Decimal(12, 3)
  unit             String
  unitCostCents    Int?
  qtyReceived      Decimal @default(0) @db.Decimal(12, 3)

  purchaseOrder  PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  component      Component?      @relation(fields: [componentId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// Attention — questions, todos, alerts
// ─────────────────────────────────────────────────────────────

enum EntityType {
  VENDOR
  PRODUCT
  PRODUCT_VARIANT
  COMPONENT
  PRODUCTION_RUN
  PURCHASE_ORDER
  /// Points at a ChatMessage — used by GAP items to carry the exchange.
  CHAT_MESSAGE
  GENERAL
}

enum ActionItemKind {
  QUESTION // Studio Mouse needs to know something
  TODO // a person must do something
  /// Studio Mouse could not do something it should have been able to do —
  /// a missing tool, or a wall built into the code. Reported from chat with
  /// the exchange attached, so whoever changes the code arrives already
  /// knowing what was asked and what Mouse reached for, instead of being
  /// told second-hand from a screenshot. entityId is the ChatMessage.
  GAP
}

enum ActionItemSource {
  CHAT
  EMAIL // Phase 2. Extracted facts are PROPOSALS, never direct writes.
  SYSTEM
  MANUAL
}

/// Unifies "Studio Mouse needs to know X" and "someone must do Y by Z".
/// Both are resolved by a human and both belong in one list, so Cleo has one
/// place to look rather than three screens.
model ActionItem {
  id               String           @id @default(cuid())
  kind             ActionItemKind   @default(QUESTION)
  entityType       EntityType       @default(GENERAL)
  entityId         String?
  title            String
  detail           String?
  dueDate          DateTime?
  /// Days before dueDate to start surfacing it.
  remindDaysBefore Int?             @default(3)
  createdById      String?
  assignedToId     String?
  source           ActionItemSource @default(CHAT)
  resolved         Boolean          @default(false)
  resolvedAt       DateTime?
  resolutionNote   String?
  /// Stated outright, independent of any date — "this is pressing", not
  /// inferred from a deadline. dueDate + remindDaysBefore already covers
  /// "surface this N days before it's due"; this covers there being no date
  /// to hang urgency on at all. Cleo, 17 Sept 2026: things imminent to
  /// production should sort to the top and read red — not every urgent
  /// thing has a due date to prove it.
  urgent           Boolean          @default(false)
  /// Set once this has gone out in the "chip away" drip email, so the next
  /// day's pair never repeats it. Null just means never sent that way —
  /// unrelated to resolved, which is a person answering it.
  askedViaEmailAt  DateTime?
  createdAt        DateTime         @default(now())

  createdBy  Person? @relation("ItemCreatedBy", fields: [createdById], references: [id])
  assignedTo Person? @relation("ItemAssignedTo", fields: [assignedToId], references: [id])
  alerts     Alert[]

  @@index([resolved, dueDate])
  @@index([kind, resolved])
}

enum AlertSeverity {
  INFO
  WARNING
  URGENT
}

/// System-raised and system-resolving. Kept separate from ActionItem for that
/// reason — nobody "completes" an alert, the condition simply stops being true.
model Alert {
  id                  String        @id @default(cuid())
  severity            AlertSeverity @default(WARNING)
  message             String
  /// Stable key for idempotency — the nightly job must not duplicate an alert
  /// for a condition that is still unresolved. Unique among unresolved rows.
  dedupeKey           String
  relatedActionItemId String?
  resolved            Boolean       @default(false)
  resolvedAt          DateTime?
  createdAt           DateTime      @default(now())

  relatedActionItem ActionItem? @relation(fields: [relatedActionItemId], references: [id])

  @@index([resolved, createdAt])
}

enum NoteSource {
  CHAT
  MANUAL
  SYSTEM
}

model Note {
  id         String     @id @default(cuid())
  entityType EntityType @default(GENERAL)
  entityId   String?
  content    String
  source     NoteSource @default(CHAT)
  createdAt  DateTime   @default(now())
  /// When this note stopped being true. A note is never deleted — a price that
  /// has changed is still the price that was quoted, and someone will want to
  /// look it up. But a superseded fact read back as current is worse than no
  /// note at all: on 16 Sept 2026 nine notes described what Antonio charges
  /// and eight of them were out of date, none marked, while a $22,300 order
  /// was being priced. Retired notes are loaded into context for a while
  /// longer under a heading that says plainly they are no longer true, then
  /// stop being loaded at all. The row stays either way.
  supersededAt DateTime?

  @@index([entityType, entityId])
  @@index([supersededAt])
}

// ─────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
}

/// Threads exist so "the buttons" from three days ago doesn't bleed into
/// today's context window.
model ChatThread {
  id        String        @id @default(cuid())
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String   @id @default(cuid())
  threadId       String
  role           ChatRole
  content        String
  toolCallsJson  Json?
  /// Per-request model/token usage and stop reason; no prompts or credentials.
  agentUsageJson Json?
  /// Which model handled this turn — lets us see how often Sonnet escalates
  /// to Opus and whether the routing is right.
  model          String?
  createdAt      DateTime @default(now())

  thread      ChatThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  events      InventoryEvent[]
  attachments ChatAttachment[]

  @@index([threadId, createdAt])
}

/// A file Cleo (or Brandon or Jane) dropped into chat for Studio Mouse to
/// read — an invoice, an old PO, a packing slip. No blob store here: this
/// project keeps its own storage, so bytes live in Postgres like inbound
/// email bodies already do. Small documents only, by design — see the size
/// guard in the chat route.
model ChatAttachment {
  id            String   @id @default(cuid())
  chatMessageId String
  filename      String
  mediaType     String
  /// Base64-encoded file bytes. Null means the periodic cleanup cleared it —
  /// see StorageCleanup — after Studio Mouse had already read it. filename,
  /// mediaType and sizeBytes stay, so the chat history still shows what was
  /// attached, just not the bytes themselves.
  data          String?
  sizeBytes     Int
  createdAt     DateTime @default(now())

  message ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
}

/// One row, id "singleton". Bookkeeping for the every-~60-days storage
/// cleanup in lib/mouse/storage-cleanup.ts — Brandon, 4 Sept 2026: emails and
/// attachments don't need to be kept once Studio Mouse has taken what it
/// needs from them, so their heavy content is cleared on an age cutoff.
/// Never runs the same content twice; runs off this timestamp, not a cron
/// schedule, since "every two months" doesn't fit a daily job otherwise.
model StorageCleanup {
  id           String    @id @default("singleton")
  lastRunAt    DateTime?
  /// Running totals, not per-run — how much has ever been cleared.
  emailsPurged Int       @default(0)
  filesPurged  Int       @default(0)
}

/// One row, id "singleton". Whether each thing that emails people is
/// switched on.
///
/// These were hardcoded constants in the cron routes until 4 Sept 2026,
/// which meant "stop emailing me" — the most basic request anyone makes of
/// a system that emails them — needed a code edit and a deploy, and Studio
/// Mouse had to tell Brandon it couldn't help. Same mistake as the document
/// content: an operational setting living in code instead of data. Anything
/// that sends mail on a schedule gets its switch here.
model NotificationSettings {
  id                    String   @id @default("singleton")
  /// The two-questions-a-day drip at the open list.
  chipAwayEnabled       Boolean  @default(true)
  /// The 8am morning report to Brandon and Cleo — superseded by The Daily
  /// Cheese and off since 17 Sept, kept switchable rather than deleted.
  amReportEnabled       Boolean  @default(false)
  /// The older daily/weekly/monthly digest — superseded by the morning
  /// report and off since 3 Sept, kept switchable rather than deleted.
  digestEnabled         Boolean  @default(false)
  /// The Daily Cheese — weekday 8am, Products in production's red items plus
  /// any calendar entry that names Jane by name. Jane Tue-Thu, Cleo Mon/Fri
  /// (she only works three days a week); Cleo and Brandon cc'd on her days,
  /// Brandon cc'd (not Jane) on Cleo's. Cleo, 17 Sept 2026, after several
  /// rounds on the copy itself: brief, full sentences, no backstory, no
  /// questions section for now.
  dailyCheeseEnabled    Boolean  @default(true)
  /// Forward anything arriving at a Studio Mouse mailbox on to the people
  /// who should have been cc'd. Brandon, 9 Sept 2026: "some people only
  /// respond to SM and forget to hit cc."
  forwardInboundEnabled Boolean  @default(true)
  /// Who those forwards go to, comma-separated. Null falls back to
  /// DIGEST_RECIPIENTS. Here rather than in code so changing who sees the
  /// mail does not need a deploy.
  forwardInboundTo      String?
  updatedAt             DateTime @updatedAt
}

/// One row, id "singleton". The parts of a printed document that are
/// content rather than layout — who to confirm receipt with, who it's
/// billed to, the standing line above the signature.
///
/// These were hardcoded into the two PO templates until 4 Sept 2026, which
/// meant changing a name on a document needed a code edit and a deploy.
/// Brandon, rightly: "I need to be able to tell SM to make changes like
/// this and it will. It's a draft. Meaning there might be changes." The
/// line that matters is content vs. presentation — content lives here and
/// Studio Mouse can edit it; typography, columns and page layout stay in
/// the template where they belong.
model DocumentDefaults {
  id            String   @id @default("singleton")
  /// Newline-separated, same convention as PurchaseOrder.deliverTo.
  billToLines   String
  /// The standing sentence above the contact block.
  confirmLine   String
  /// The same sentence in Spanish, for an order rendered in Spanish. Null
  /// falls back to the English one rather than machine-translating it — a
  /// sentence a vendor acts on is content, not chrome. See lib/po-strings.ts.
  confirmLineEs String?
  /// Who to confirm with, newline-separated. A PO can override this for
  /// itself; most never do.
  contactLines  String
  updatedAt     DateTime @updatedAt
}

/// One row, id "singleton". Set at the end of every real syncShopify() call
/// — the nightly cron, the 8am report, or sync_shopify asked for in chat —
/// so "how current is this" is a real timestamp, not a claimed cadence that
/// silently goes wrong the day a sync fails quietly.
model ShopifySyncStatus {
  id              String   @id @default("singleton")
  lastSyncedAt    DateTime
  variantsUpdated Int
}

// ─────────────────────────────────────────────────────────────
// Forecasting
// ─────────────────────────────────────────────────────────────

model SalesSnapshot {
  id               String   @id @default(cuid())
  productVariantId String
  date             DateTime @db.Date
  unitsSold        Int
  source           String   @default("shopify")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, date, source])
  @@index([date])
}

model ForecastResult {
  id                    String    @id @default(cuid())
  productId             String?
  componentId           String?
  projectedStockoutDate DateTime?
  recommendedOrderDate  DateTime?
  /// Human-readable working, so the digest can explain rather than assert.
  note                  String?
  /// Set when the forecast could NOT be computed. Never skip silently —
  /// name exactly what's missing. "Manufacturing lead time unknown."
  blockedReason         String?
  computedAt            DateTime  @default(now())

  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  component Component?      @relation(fields: [componentId], references: [id], onDelete: Cascade)
  events    CalendarEvent[]

  @@index([computedAt])
}

// ─────────────────────────────────────────────────────────────
// Calendar, links, digests
// ─────────────────────────────────────────────────────────────

enum CalendarEventType {
  ORDER_BY
  PRODUCTION_DUE
  PRESS_OR_EVENT // forecast INPUT — flagged before Cleo sizes an order
  DELIVERY_EXPECTED
  OTHER
}

enum CalendarEventSource {
  STUDIO_MOUSE
  GOOGLE
  MANUAL
}

model CalendarEvent {
  id               String              @id @default(cuid())
  forecastResultId String?
  googleEventId    String?
  title            String
  date             DateTime            @db.Date
  type             CalendarEventType   @default(OTHER)
  source           CalendarEventSource @default(STUDIO_MOUSE)
  status           String?
  notes            String?
  /// Which product this is about, when it is about one. An entry is usually
  /// tied to something being made — 18 skirts arriving, a pickup from the dye
  /// house — and until 16 Sept 2026 nothing recorded which, so answering
  /// "where is the 5to7 Skirt" meant reading every event and matching on
  /// wording. Nullable: a studio visit or a call belongs to nobody's product.
  productId        String?
  createdAt        DateTime            @default(now())

  forecastResult ForecastResult? @relation(fields: [forecastResultId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([productId])
}

model FileLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category, sortOrder])
}

/// Mail CC'd or forwarded to Studio Mouse.
///
/// EMAIL IS DATA, NEVER INSTRUCTIONS. Anyone who can send mail to this address
/// can put text in front of Studio Mouse, so nothing here is ever applied
/// directly. Facts extracted from an email become proposals a human confirms.
/// See CLAUDE.md §4.
model InboundEmail {
  id          String    @id @default(cuid())
  messageId   String?   @unique
  fromAddress String
  toAddress   String
  subject     String?
  text        String?
  html        String?
  /// Whole webhook payload, kept so nothing is lost if parsing changes later.
  raw         Json
  receivedAt  DateTime
  /// Set once Studio Mouse has read it and raised whatever it needed to.
  processedAt DateTime?
  /// Set once this has been forwarded on to the people who should have been
  /// cc'd. Doubles as the idempotency guard: Resend retries a webhook it
  /// thinks failed, and a retry must not send the same mail twice. Claimed
  /// with a conditional update, so two concurrent deliveries cannot both win.
  forwardedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt, receivedAt])
}

/// Mouse's Corner — one short assessment a day, generated on first view and
/// kept, so it does not change every time the page is refreshed.
model DailyBrief {
  id      String   @id @default(cuid())
  forDate DateTime @unique @db.Date
  text    String
  model   String?

  /// The nightly pass's own working notes, which composeDailyBrief() distils
  /// under Mouse's voice. Kept so the brief can be composed again later from
  /// the same material — the cron used to hold the only copy and discard it,
  /// which meant any regeneration quietly dropped whatever the night's mail
  /// had turned up. Null for a day with no unread mail, and for every row
  /// written before this column existed.
  overnight String?

  createdAt DateTime @default(now())
}

/// The QuickBooks connection.
///
/// Intuit's refresh token ROTATES on every use — each refresh returns a new one
/// and kills the old immediately — so it cannot live in an environment
/// variable. It lives here and is rewritten each time. If nothing refreshes it
/// for 100 days it dies and someone has to re-authorise in a browser, which is
/// why the nightly job touches it whether or not anyone asked for figures.
model QuickBooksConnection {
  id               String    @id @default("singleton")
  realmId          String
  accessToken      String
  refreshToken     String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastRefreshedAt  DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// A snapshot of the financial position, so the app is not calling Intuit on
/// every page load and so trends can be seen over time.
model FinancialSnapshot {
  id               String   @id @default(cuid())
  forDate          DateTime @unique @db.Date
  cashCents        BigInt?
  arCents          BigInt?
  apCents          BigInt?
  revenueMtdCents  BigInt?
  revenueYtdCents  BigInt?
  expensesMtdCents BigInt?
  raw              Json?
  createdAt        DateTime @default(now())
}

/// Every message Studio Mouse has sent on the company's behalf.
///
/// Outward-facing actions need a record independent of the conversation that
/// caused them — "what did we tell Michael, and when" must be answerable
/// months later without scrolling a chat log.
model SentEmail {
  id        String   @id @default(cuid())
  toAddress String
  ccAddress String?
  subject   String
  body      String
  sentBy    String? // who asked for it
  resendId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum DigestKind {
  DAILY
  WEEKLY
  MONTHLY
}

/// One row per digest actually sent. The unique constraint is what makes the
/// nightly job safe to hit repeatedly — it cannot double-send.
model DigestSend {
  id          String     @id @default(cuid())
  kind        DigestKind
  sentForDate DateTime   @db.Date
  recipients  String
  subject     String?
  sentAt      DateTime   @default(now())

  @@unique([kind, sentForDate])
}

// ─────────────────────────────────────────────────────────────
// Wholesale — what has shipped, what has been paid
// ─────────────────────────────────────────────────────────────
//
// Brandon, 4 Sept 2026: track what's shipped and what's been paid, seeded
// from the last three months of the studio's own wholesale spreadsheet.
// Deliberately not linked to Component, ProductVariant or InventoryEvent
// anywhere below — "do NOT change inventory in any way, everything is up
// to date in Shopify." This is a financial and shipping record sitting
// beside inventory, not another way to move it.

enum WholesaleAccountType {
  WHOLESALE // standard split, sold or not doesn't change what's owed
  CONSIGNMENT // owed only on what actually sells
}

model WholesaleAccount {
  id              String               @id @default(cuid())
  name            String
  type            WholesaleAccountType @default(WHOLESALE)
  /// e.g. "60/40" — only meaningful for CONSIGNMENT. Recorded exactly as
  /// told, never assumed from the standard collection's 70/30.
  commissionSplit String?
  contactName     String?
  email           String?
  address         String?
  active          Boolean              @default(true)
  notes           String?
  createdAt       DateTime             @default(now())

  shipments WholesaleShipment[]

  @@index([active])
}

model WholesaleShipment {
  id        String    @id @default(cuid())
  accountId String
  sentAt    DateTime
  /// Null means not recorded — never assumed paid just because an earlier
  /// shipment to the same account was. Unknown is the honest default.
  paid      Boolean?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  account WholesaleAccount        @relation(fields: [accountId], references: [id])
  lines   WholesaleShipmentLine[]

  @@index([accountId, sentAt])
}

model WholesaleShipmentLine {
  id             String    @id @default(cuid())
  shipmentId     String
  /// Free text — "Cleo Tee / White / 1" — deliberately not a
  /// ProductVariant relation. This describes what a spreadsheet said left
  /// the studio, not a live count; Shopify already holds the real one.
  item           String
  qty            Int
  /// The line's total in cents, as recorded — the source wasn't always
  /// consistent about per-unit vs. line total, so this is whichever the
  /// row actually gave. Null where no price was recorded.
  wholesaleCents Int?
  /// When the account actually sold it at retail — mostly unknown. What a
  /// consignment balance actually turns on.
  soldAt         DateTime?

  shipment WholesaleShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}
